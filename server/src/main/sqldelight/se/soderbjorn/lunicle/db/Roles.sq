-- Who stands where: a person's rung in a project, and the rungs a project hands
-- to whole audiences (LNL-191).
--
-- Two tables, and between them they are the entire access model's storage.
--
-- `project_roles` holds ONE row per person per project — the primary key is
-- (user_id, project_id), not (user_id, project_id, role). A person has one rung,
-- because the rungs are cumulative: Maintainer answers every question Contributor
-- answers, so holding both would be holding the same thing twice. The rung *name*
-- is the only thing stored. There is no per-privilege column, and no `roles` table
-- defining what a rung means, because what a rung permits is a function in
-- AccessControl — which is what makes widening a rung a deploy rather than a
-- migration of every holder.
--
-- `project_audience_roles` holds AT MOST THREE rows per project, one per audience
-- (`guest`, `member`, `staff`), each naming the rung everybody in that audience
-- arrives at. These replace `projects.is_public` and
-- `projects.visible_to_all_signed_in`, both dropped in 33.sqm: where those two
-- booleans could only say "readable by strangers" and "readable by accounts", an
-- audience row says *which rung* an audience reaches — so "everyone here may file
-- bugs" is one row rather than a grant per person.
--
-- Only AccessControl combines the two, once, in `effectiveRole`:
--
--     effective = max(the audience rows the user matches, the user's own row)
--
-- An own row can raise somebody above their audience and never cuts them below it.
-- Nothing in this file knows that rule; these are two tables of names.
--
-- Neither table's values are constrained to the enum by SQLite, deliberately, and
-- it matches how role keys have always been read: an unrecognised name is dropped
-- on the way out (see RoleStore), so a row written by a newer build grants nothing
-- on an older one rather than failing its reads.

CREATE TABLE project_roles (
    user_id INTEGER NOT NULL,
    project_id INTEGER NOT NULL,

    -- A ProjectRole.key: viewer | contributor | maintainer | admin | owner.
    role TEXT NOT NULL,

    PRIMARY KEY (user_id, project_id),
    FOREIGN KEY (user_id) REFERENCES users(id) ON DELETE CASCADE,
    FOREIGN KEY (project_id) REFERENCES projects(id) ON DELETE CASCADE
);

-- Everyone a project admits wholesale, by where they stand on the instance.
CREATE TABLE project_audience_roles (
    project_id INTEGER NOT NULL,

    -- An Audience.key: guest | member | staff. The bottom three rungs of the
    -- instance ladder, so a `guest` row matches everybody and a `staff` row matches
    -- only accounts from the deployment's own domain.
    audience TEXT NOT NULL,

    -- A ProjectRole.key, as above.
    role TEXT NOT NULL,

    PRIMARY KEY (project_id, audience),
    FOREIGN KEY (project_id) REFERENCES projects(id) ON DELETE CASCADE
);

-- One person's rung here. What AccessControl asks, one pair at a time, from the
-- session — never the whole table.
roleFor:
SELECT role FROM project_roles WHERE user_id = ? AND project_id = ?;

-- One person's rungs everywhere, in one read. For the callers that would otherwise
-- ask roleFor once per project.
rolesForUser:
SELECT project_id, role FROM project_roles WHERE user_id = ?;

-- Every own-row grant in one project, for the settings dialog's privileges table.
--
-- Note the direction this is read in: it answers "who holds what here", which is an
-- administrative question, never a permission one. See AccessControl's preamble.
rolesForProject:
SELECT user_id, role FROM project_roles WHERE project_id = ?;

-- Everyone with an own row here. ProjectAudience's question, and the only reason it
-- is separate from rolesForProject — that caller wants ids and nothing else.
memberIds:
SELECT user_id FROM project_roles WHERE project_id = ?;

-- Single-valued by construction: the conflict target is the whole primary key, so
-- moving somebody up or down a rung rewrites the one row they have rather than
-- adding a second.
setRole:
INSERT INTO project_roles (user_id, project_id, role)
VALUES (?, ?, ?)
ON CONFLICT (user_id, project_id) DO UPDATE SET role = excluded.role;

-- Removing somebody's own row. Idempotent — clearing what nobody holds is not an
-- error. It does NOT necessarily remove their access: an audience row may still
-- admit them, which is the whole point of the max rule.
clearRole:
DELETE FROM project_roles WHERE user_id = ? AND project_id = ?;

audienceRoles:
SELECT audience, role FROM project_audience_roles WHERE project_id = ?;

setAudienceRole:
INSERT INTO project_audience_roles (project_id, audience, role)
VALUES (?, ?, ?)
ON CONFLICT (project_id, audience) DO UPDATE SET role = excluded.role;

clearAudienceRole:
DELETE FROM project_audience_roles WHERE project_id = ? AND audience = ?;
