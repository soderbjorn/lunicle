-- Version 15 → 16: forum posts, flat comments on them, and attachments in both.
--
-- Two new tables and one rebuilt one. The dual-path story is 1.sqm's and 2.sqm's:
-- a fresh volume runs `CREATE TABLE` out of the .sq files and gets all of this
-- for free; a volume already at version 15 — the deployed one — runs this
-- instead. MigrationTest migrates every earlier snapshot forward and compares
-- PRAGMA output against a fresh `Schema.create`, so drift between the two files
-- fails the build rather than the volume.
--
-- ── Order matters here, unlike in 14.sqm ────────────────────────────────────
--
-- The rebuilt `attachments` carries foreign keys at `forum_posts` and
-- `forum_comments`, so both must exist before it is created. SQLite would accept
-- the reverse — a foreign key naming a missing table is only an error when a row
-- is written, not when the table is declared — which is exactly why the ordering
-- is stated rather than left to look accidental: getting it backwards produces a
-- schema that creates cleanly and then fails on the first upload.
--
-- ── Why `attachments` is rebuilt, and why that is safe ──────────────────────
--
-- 13.sqm is the precedent and its reasoning is the reasoning here, so this is the
-- short version. Two things ALTER TABLE cannot do: it cannot widen a CHECK, and
-- the CHECK on this table is the whole point of the columns being nullable — it
-- has to change from "exactly one of two owners" to "exactly one of four", or a
-- forum attachment is unrepresentable. (It CAN add the two nullable columns, so
-- the rebuild is forced by the constraint alone.)
--
-- The rebuild is safe on this table in a way it would not be on `issues`:
-- **nothing in this schema has a foreign key pointing AT `attachments`**. Every
-- key points the other way — at issues, comments, users, and now forum posts and
-- forum comments — so dropping and recreating it cannot cascade into anything.
-- 3.sqm's warning about DROP TABLE with foreign keys off is about `issues`, which
-- every other table references. This table is still a leaf.
--
-- ── What existing rows get ──────────────────────────────────────────────────
--
-- NULL in both new columns, which is not a backfill decision so much as the only
-- coherent answer: every attachment on the deployed volume belongs to an issue or
-- an issue comment, because forum posts did not exist until this statement ran.
-- The CHECK is satisfied by the owner they already have.
--
-- `id` is carried across explicitly rather than left to AUTOINCREMENT, for
-- 13.sqm's reason: `public_id` was backfilled from `id` for the rows that predate
-- it, so a row that came back with a different id would change its own URL and —
-- worse — could be the second row to claim an existing one.
--
-- The statements below reproduce ForumPosts.sq, ForumComments.sq and
-- Attachments.sq's CREATE TABLE blocks, minus the prose. See those files for what
-- each column and constraint is for.

CREATE TABLE forum_posts (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    forum_id INTEGER NOT NULL,

    title TEXT NOT NULL,

    body TEXT NOT NULL,
    created_at INTEGER NOT NULL,
    created_by INTEGER,

    created_by_external TEXT,

    agent_name TEXT,

    is_draft INTEGER NOT NULL DEFAULT 1,

    FOREIGN KEY (forum_id) REFERENCES forums(id) ON DELETE CASCADE,
    FOREIGN KEY (created_by) REFERENCES users(id) ON DELETE SET NULL,
    CHECK (created_by IS NULL OR created_by_external IS NULL)
);

CREATE TABLE forum_comments (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    post_id INTEGER NOT NULL,
    body TEXT NOT NULL,
    created_at INTEGER NOT NULL,
    created_by INTEGER,
    created_by_external TEXT,
    agent_name TEXT,
    is_draft INTEGER NOT NULL DEFAULT 1,
    FOREIGN KEY (post_id) REFERENCES forum_posts(id) ON DELETE CASCADE,
    FOREIGN KEY (created_by) REFERENCES users(id) ON DELETE SET NULL,
    CHECK (created_by IS NULL OR created_by_external IS NULL)
);

CREATE TABLE attachments_new (
    id INTEGER PRIMARY KEY AUTOINCREMENT,

    issue_id INTEGER,
    comment_id INTEGER,
    forum_post_id INTEGER,
    forum_comment_id INTEGER,

    filename TEXT NOT NULL,
    mime_type TEXT NOT NULL,
    byte_size INTEGER NOT NULL,

    storage_key TEXT NOT NULL UNIQUE,

    public_id TEXT NOT NULL UNIQUE,

    created_at INTEGER NOT NULL,
    created_by INTEGER,

    created_by_external TEXT,

    FOREIGN KEY (issue_id) REFERENCES issues(id) ON DELETE CASCADE,
    FOREIGN KEY (comment_id) REFERENCES comments(id) ON DELETE CASCADE,
    FOREIGN KEY (forum_post_id) REFERENCES forum_posts(id) ON DELETE CASCADE,
    FOREIGN KEY (forum_comment_id) REFERENCES forum_comments(id) ON DELETE CASCADE,
    FOREIGN KEY (created_by) REFERENCES users(id) ON DELETE SET NULL,

    CHECK (
        (issue_id IS NOT NULL) + (comment_id IS NOT NULL) +
            (forum_post_id IS NOT NULL) + (forum_comment_id IS NOT NULL) = 1
    ),

    CHECK (created_by IS NULL OR created_by_external IS NULL)
);

INSERT INTO attachments_new (
    id, issue_id, comment_id, filename, mime_type, byte_size, storage_key, public_id,
    created_at, created_by, created_by_external
)
SELECT
    id, issue_id, comment_id, filename, mime_type, byte_size, storage_key, public_id,
    created_at, created_by, created_by_external
FROM attachments;

DROP TABLE attachments;

ALTER TABLE attachments_new RENAME TO attachments;
