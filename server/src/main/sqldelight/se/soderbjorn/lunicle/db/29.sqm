-- Version 29 → 30: project-scoped release versions, and the fix-version rule (LNL-134).
--
-- A new `versions` table, two nullable references to it on `issues`, a done flag on
-- `resolutions`, and a requirement flag on `projects`. See Versions.sq for what a
-- version is, Issues.sq's planned_version_id/fixed_version_id for why those
-- references are single-column, Resolutions.sq's is_done and Projects.sq's
-- require_fixed_version_on_resolve for how "require a fixed version when resolving"
-- reads across the three rows it spans.
--
-- ── Nothing to back-fill ────────────────────────────────────────────────────
--
-- Like 9.sqm (sprints), this seeds nothing: no project gets a first version, and
-- the backlog of "no version" is `NULL`, an absence rather than a row. A project
-- with zero versions has an empty version list, empty pickers, and every issue
-- correctly un-versioned — indistinguishable from the state before this ran.
--
-- The two flag columns are NOT NULL DEFAULT 0, which back-fills every existing
-- resolution as not-done and every existing project as not-requiring — the state
-- each had before the column existed, so nothing starts demanding a fixed version.
-- 24.sqm's reasoning for require_label applies verbatim.
--
-- ── Plain ALTER TABLE, and order ────────────────────────────────────────────
--
-- Both new issue columns are single-column nullable references, the exact case
-- SQLite's ALTER TABLE ADD COLUMN accepts — 9.sqm's sprint_id is the long version
-- of this. The default is omitted because SQLite REQUIRES the default of an added
-- column with a REFERENCES clause to be NULL. `versions` is created first because
-- both ALTERs point at it; SQLite would resolve the target lazily with foreign keys
-- off (how Database.migrateSchema runs), but a file that only works with the
-- constraints disabled is a trap for whoever edits it next.
--
-- The CREATE below is duplicated from Versions.sq minus its prose and must stay in
-- step with it; MigrationTest applies every .sqm to the previous snapshot and
-- compares the result column for column and foreign key for foreign key against
-- what the .sq files create from scratch.

CREATE TABLE versions (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    project_id INTEGER NOT NULL,
    name TEXT NOT NULL COLLATE NOCASE,
    position INTEGER NOT NULL,

    FOREIGN KEY (project_id) REFERENCES projects(id) ON DELETE CASCADE,
    UNIQUE (project_id, name),
    UNIQUE (id, project_id)
);

ALTER TABLE issues ADD COLUMN planned_version_id INTEGER REFERENCES versions(id) ON DELETE SET NULL;

ALTER TABLE issues ADD COLUMN fixed_version_id INTEGER REFERENCES versions(id) ON DELETE SET NULL;

ALTER TABLE resolutions ADD COLUMN is_done INTEGER NOT NULL DEFAULT 0;

ALTER TABLE projects ADD COLUMN require_fixed_version_on_resolve INTEGER NOT NULL DEFAULT 0;
