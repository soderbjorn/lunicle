-- Per-project component vocabulary. Identical in shape to labels; see
-- Labels.sq for why each constraint is there.

CREATE TABLE components (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    project_id INTEGER NOT NULL,
    name TEXT NOT NULL COLLATE NOCASE,
    FOREIGN KEY (project_id) REFERENCES projects(id) ON DELETE CASCADE,
    UNIQUE (project_id, name),
    UNIQUE (id, project_id)
);

insert:
INSERT INTO components (project_id, name) VALUES (?, ?);

-- Rename only; see Labels.sq's `update` for why project_id is not settable.
update:
UPDATE components SET name = ? WHERE id = ?;

delete:
DELETE FROM components WHERE id = ?;

findByIdInProject:
SELECT id, project_id, name FROM components WHERE id = ? AND project_id = ?;

forProject:
SELECT id, project_id, name FROM components WHERE project_id = ? ORDER BY name;
