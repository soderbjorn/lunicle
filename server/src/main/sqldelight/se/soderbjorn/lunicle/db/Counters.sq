-- The counter, now that it belongs to someone.
--
-- Its own table rather than a column on `users`, for the same reason the
-- counter exists at all: it is the stand-in for real per-user data. When issues
-- arrive they will be a table keyed by user, not four more columns on the
-- identity — so the counter is shaped like the thing it is rehearsing.

CREATE TABLE counters (
    -- One row per user, enforced by making the foreign key the primary key.
    -- There is no separate counter id, because a counter has no identity apart
    -- from whose it is.
    user_id INTEGER PRIMARY KEY NOT NULL,

    count INTEGER NOT NULL DEFAULT 0,

    FOREIGN KEY (user_id) REFERENCES users(id) ON DELETE CASCADE
);

-- Null for a user who has never incremented — CounterStore reads that as zero.
-- A row is only written on the first increment, so signing in costs no write.
select:
SELECT count FROM counters WHERE user_id = ?;

-- Increment, creating the row if this is the user's first tap, and return the
-- new value — all in one statement.
--
-- Written this way so the read-modify-write cannot race. The obvious
-- alternative — SELECT, add one, UPDATE — has a genuine lost-update window
-- between the read and the write, and `count = count + 1` closes it by letting
-- SQLite do the arithmetic under the row lock.
--
-- RETURNING then hands back the value this statement produced, rather than
-- whatever a concurrent increment might have left behind by the time we could
-- SELECT it. Same reasoning as the AtomicInteger this replaces.
increment:
INSERT INTO counters (user_id, count)
VALUES (?, 1)
ON CONFLICT (user_id) DO UPDATE SET count = count + 1
RETURNING count;
